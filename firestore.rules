rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // User Sessions Subcollection
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId) && isValidId(sessionId);
      }
    }

    // Global Leaderboard
    match /leaderboard/{userId} {
      allow read: if true; // Public leaderboard
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    // Custom Questions (Teacher Studio & Community)
    match /custom_questions/{questionId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(questionId) && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && isValidId(questionId) && resource.data.creatorId == request.auth.uid;
    }
  }
}

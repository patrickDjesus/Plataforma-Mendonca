VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# (opcional) Endpoint da API do corretor ortográfico (LanguageTool).
# Padrão: https://api.languagetool.org/v2 (gratuita, limite de ~20 req/min/IP).
# Para self-host, aponte para a sua instância, ex.:
#   VITE_LANGUAGETOOL_API_URL=http://localhost:8081/v2
VITE_LANGUAGETOOL_API_URL=

# IMPORTANTE (IA Groq):
# NÃO coloque a chave do Groq aqui. Ela é usada SOMENTE no servidor, como secret
# da Supabase Edge Function "groq-chat". Configure via CLI:
#   supabase secrets set GROQ_API_KEY=gsk_xxxxxxxx
# (opcional) modelo padrão:
#   supabase secrets set GROQ_MODEL=qwen/qwen3.8-27b

# (opcional) Chave da API do Groq usada pelo criador de Teste (DocQuiz) direto
# no frontend (apenas desenvolvimento local). No. env, NÃO compartilhar.
# VITE_GROQ_API_KEY=
# VITE_GROQ_MODEL=openai/gpt-oss-120b
# VITE_GROQ_FALLBACK_MODEL=groq/compound
